{
  "$description": "Checkable values for the rules in this repository. Format follows the W3C Design Tokens Community Group draft ($value, $type, $description). Each token names the rule it implements.",
  "space": {
    "$type": "dimension",
    "$description": "LAY-05 closed spacing scale, 4 pt base. Values outside this set are violations.",
    "1": { "$value": "4pt" },
    "2": { "$value": "8pt" },
    "3": { "$value": "12pt" },
    "4": { "$value": "16pt" },
    "5": { "$value": "20pt" },
    "6": { "$value": "24pt" },
    "8": { "$value": "32pt" },
    "10": { "$value": "40pt" },
    "12": { "$value": "48pt" },
    "16": { "$value": "64pt" },
    "20": { "$value": "80pt" },
    "24": { "$value": "96pt" },
    "groupRatioMin": { "$type": "number", "$value": 2, "$description": "LAY-06 minimum ratio of between-group gap to largest within-group gap." }
  },
  "radius": {
    "$type": "dimension",
    "$description": "SHP-02 closed radius set (values are the owner's choice, evidence: taste). Nested radii are derived with SHP-01: inner = max(0, outer - padding).",
    "small": { "$value": "8pt" },
    "medium": { "$value": "16pt" },
    "large": { "$value": "24pt" },
    "full": { "$value": "9999pt", "$description": "Capsule / circle." }
  },
  "type": {
    "minimum": {
      "$type": "dimension",
      "$description": "TYP-01 minimum text size per platform [S4].",
      "ios": { "$value": "11pt" },
      "macos": { "$value": "10pt" },
      "tvos": { "$value": "23pt" },
      "visionos": { "$value": "12pt" },
      "watchos": { "$value": "12pt" }
    },
    "defaultBody": {
      "$type": "dimension",
      "$description": "TYP-01 default body size per platform [S4].",
      "ios": { "$value": "17pt" },
      "macos": { "$value": "13pt" },
      "tvos": { "$value": "29pt" },
      "visionos": { "$value": "17pt" },
      "watchos": { "$value": "16pt" }
    },
    "scale": {
      "ios": {
        "$description": "TYP-06 iOS default (Large) Dynamic Type styles: size / line height in pt, weight [S4].",
        "largeTitle": { "$type": "typography", "$value": { "fontSize": "34pt", "lineHeight": "41pt", "fontWeight": 400 } },
        "title1": { "$type": "typography", "$value": { "fontSize": "28pt", "lineHeight": "34pt", "fontWeight": 400 } },
        "title2": { "$type": "typography", "$value": { "fontSize": "22pt", "lineHeight": "28pt", "fontWeight": 400 } },
        "title3": { "$type": "typography", "$value": { "fontSize": "20pt", "lineHeight": "25pt", "fontWeight": 400 } },
        "headline": { "$type": "typography", "$value": { "fontSize": "17pt", "lineHeight": "22pt", "fontWeight": 600 } },
        "body": { "$type": "typography", "$value": { "fontSize": "17pt", "lineHeight": "22pt", "fontWeight": 400 } },
        "callout": { "$type": "typography", "$value": { "fontSize": "16pt", "lineHeight": "21pt", "fontWeight": 400 } },
        "subhead": { "$type": "typography", "$value": { "fontSize": "15pt", "lineHeight": "20pt", "fontWeight": 400 } },
        "footnote": { "$type": "typography", "$value": { "fontSize": "13pt", "lineHeight": "18pt", "fontWeight": 400 } },
        "caption1": { "$type": "typography", "$value": { "fontSize": "12pt", "lineHeight": "16pt", "fontWeight": 400 } },
        "caption2": { "$type": "typography", "$value": { "fontSize": "11pt", "lineHeight": "13pt", "fontWeight": 400 } }
      }
    },
    "lineHeightBody": {
      "$type": "number",
      "$description": "TYP-05 body leading as a multiple of font size [S17].",
      "min": { "$value": 1.2 },
      "max": { "$value": 1.45 }
    },
    "measure": {
      "$type": "number",
      "$description": "TYP-04 average characters per line, including spaces [S17].",
      "min": { "$value": 45 },
      "max": { "$value": 90 }
    },
    "userSpacingOverrides": {
      "$type": "number",
      "$description": "TYP-05 / WCAG 1.4.12: layouts must survive these user settings, as multiples of font size [S15].",
      "lineHeight": { "$value": 1.5 },
      "paragraphSpacing": { "$value": 2.0 },
      "letterSpacing": { "$value": 0.12 },
      "wordSpacing": { "$value": 0.16 }
    },
    "allCapsTracking": {
      "$type": "number",
      "$description": "TYP-10 extra letter spacing for all caps, as a fraction of font size [S17].",
      "min": { "$value": 0.05 },
      "max": { "$value": 0.12 }
    },
    "maxTypefaces": { "$type": "number", "$value": 2, "$description": "TYP-08." },
    "resizeTarget": {
      "$type": "number",
      "$description": "TYP-03 minimum supported text enlargement [S6].",
      "default": { "$value": 2.0 },
      "watchos": { "$value": 1.4 }
    }
  },
  "contrast": {
    "wcag": {
      "$type": "number",
      "$description": "COL-01 / COL-02 minimum contrast ratios, WCAG 2.2 AA [S6][S13].",
      "normalText": { "$value": 4.5 },
      "largeText": { "$value": 3.0 },
      "nonText": { "$value": 3.0 },
      "focusIndicator": { "$value": 3.0 }
    },
    "apca": {
      "$type": "number",
      "$description": "COL-03 secondary perceptual check, APCA Lc (absolute value) [S16].",
      "body": { "$value": 75 },
      "bodyPreferred": { "$value": 90 },
      "otherText": { "$value": 60 },
      "largeHeading": { "$value": 45 },
      "nonText": { "$value": 30 }
    }
  },
  "target": {
    "$type": "dimension",
    "$description": "INT-01 / INT-02 interactive target sizes (square) [S6][S14][S20].",
    "ios": { "default": { "$value": "44pt" }, "minimum": { "$value": "28pt" } },
    "macos": { "default": { "$value": "28pt" }, "minimum": { "$value": "20pt" } },
    "tvos": { "default": { "$value": "66pt" }, "minimum": { "$value": "56pt" } },
    "visionos": { "default": { "$value": "60pt" }, "minimum": { "$value": "28pt" } },
    "watchos": { "default": { "$value": "44pt" }, "minimum": { "$value": "28pt" } },
    "web": { "default": { "$value": "44px" }, "minimum": { "$value": "24px" } },
    "material": { "default": { "$value": "48dp" } },
    "paddingBezeled": { "$value": "12pt", "$description": "INT-03." },
    "paddingBorderless": { "$value": "24pt", "$description": "INT-03." }
  },
  "safeZone": {
    "$type": "dimension",
    "$description": "LAY platform specifics, tvOS overscan [S3].",
    "tvosVertical": { "$value": "60px" },
    "tvosHorizontal": { "$value": "80px" }
  },
  "material": {
    "clearDimOpacity": { "$type": "number", "$value": 0.35, "$description": "SHP-06 dark dimming behind clear glass over bright media [S8]." }
  },
  "motion": {
    "spring": {
      "$description": "MOT-06 springs as perceived duration (s) + bounce [S11].",
      "smooth": { "$type": "object", "$value": { "duration": 0.5, "bounce": 0.0 } },
      "subtle": { "$type": "object", "$value": { "duration": 0.5, "bounce": 0.15 } },
      "bouncy": { "$type": "object", "$value": { "duration": 0.5, "bounce": 0.3 } }
    },
    "maxFlashesPerSecond": { "$type": "number", "$value": 3, "$description": "MOT-09, WCAG 2.3.1 [S13]." },
    "avoidOscillationHz": { "$type": "number", "$value": 0.2, "$description": "MOT-10 visionOS [S7]." }
  },
  "response": {
    "$type": "duration",
    "$description": "FBK-01 response-time limits [S18][S19].",
    "instant": { "$value": "100ms" },
    "flow": { "$value": "1000ms" },
    "attention": { "$value": "10000ms" },
    "doherty": { "$value": "400ms" }
  }
}
